# Copy to .env. Never commit .env.
# postgres or pglite
DB_DRIVER=pglite
# Required when DB_DRIVER=postgres
DATABASE_URL=
PGLITE_DATA_DIR=./pglite-data
# PGlite only: a snapshot of the data folder each day, the newest 7 kept, in BACKUP_DIR.
BACKUPS_ENABLED=true
BACKUP_DIR=./pglite-backups
# cloud or hub
SERVER_PROFILE=hub
# At least 32 characters. Leave empty to have one generated on the first start.
SYNC_TOKEN=
PORT=8787
BIND_HOST=0.0.0.0
LOG_LEVEL=info
# true: stop cleanly when stdin closes. The desktop app sets this for the hub it runs.
SHUTDOWN_ON_STDIN_CLOSE=false

# The server organizes entries that devices left waiting (docs/architecture/extraction-pipeline.md).
FALLBACK_EXTRACTION_ENABLED=true
# Minutes an entry from a device that organizes its own waits before the server takes it.
# Entries from devices set to let the hub do it are taken at once.
FALLBACK_GRACE_MINUTES=15
# groq, google or ollama. Leave empty and the server organizes nothing.
EXTRACTION_PROVIDER=
EXTRACTION_MODEL=
# The hub answers Ask questions for devices set to use it: groq, google or ollama. Empty: it doesn't.
ANALYSIS_PROVIDER=
ANALYSIS_MODEL=
# Search by meaning: ollama or google (Groq has no embedding models). Empty: search is off.
# The suggested Ollama model is in packages/core/src/models/presets.json.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
# Only for ollama, when it isn't at http://localhost:11434/v1
OLLAMA_BASE_URL=
GROQ_API_KEY=
GOOGLE_API_KEY=

{
  "expo": {
    "name": "Avchetan",
    "slug": "avchetan",
    "scheme": "avchetan",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.avchetan",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "./plugins/long-native-paths.js",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class * extends androidx.work.ListenableWorker { *; }\n-keep class expo.modules.backgroundtask.** { *; }\n-keep class expo.modules.taskManager.** { *; }\n"
          }
        }
      ]
    ]
  }
}

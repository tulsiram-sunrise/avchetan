{
  "name": "avchetan",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @avchetan/db db:generate",
    "eval:extraction": "pnpm --filter @avchetan/core eval:extraction",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "lefthook install",
    "licenses:check": "node tooling/scripts/check-licenses.ts",
    "docs:check-links": "node tooling/scripts/check-doc-links.ts",
    "errors:check": "node tooling/scripts/check-error-codes.ts",
    "icons": "node tooling/scripts/build-icons.ts",
    "docs:dev": "pnpm --filter @avchetan/docs-site dev",
    "docs:build": "pnpm --filter @avchetan/docs-site build",
    "version:set": "node tooling/scripts/version.ts set",
    "version:check": "node tooling/scripts/version.ts check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "github-slugger": "2.0.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

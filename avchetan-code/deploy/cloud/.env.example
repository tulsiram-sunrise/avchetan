# Copy to deploy/cloud/.env and fill in. Never commit .env: it holds your passwords.

# Your server's domain name. Its DNS A record must point at this server before you start,
# so Caddy can get the HTTPS certificate. Example: avchetan.example.com
DOMAIN=

# The database password: letters and numbers only, at least 24 characters.
POSTGRES_PASSWORD=

# Leave empty: the server makes a token on its first start and prints it in its log.
# Set it (at least 32 characters) only to choose your own; then "Change token" in the app
# is turned off and you change it here.
SYNC_TOKEN=

LOG_LEVEL=info

# Organizing entries and answering questions on the server (optional). Without them, each
# device uses its own AI models. A free Groq key works; it sends your entries to Groq.
# Model names: docs/user-guide/ai-models.md
EXTRACTION_PROVIDER=
EXTRACTION_MODEL=
ANALYSIS_PROVIDER=
ANALYSIS_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
GROQ_API_KEY=
GOOGLE_API_KEY=
# Preview: OpenAI and Anthropic (Claude) charge per use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Preview: any service that speaks OpenAI's API (provider openai_compatible). The key is optional.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Only for Ollama on another machine you control, for example over Tailscale.
OLLAMA_BASE_URL=
